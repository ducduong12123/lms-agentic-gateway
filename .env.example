# Gateway URL (chính gateway này)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8001
PUBLIC_ORIGINS=http://localhost:8080,http://lms.localhost:8080,http://localhost:8000,http://lms.localhost:8000,http://127.0.0.1:8080,http://127.0.0.1:8000

# LLM OpenAI-compatible (OpenAI / Ollama / vLLM / LM Studio đều được)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-4o-mini

# Frappe LMS
FRAPPE_URL=http://learning.test:8000
FRAPPE_SITE_HOST=lms.localhost
FRAPPE_API_KEY=put_key_here
FRAPPE_API_SECRET=put_secret_here

# Webhook shared secret (cấu hình trùng trong Frappe Webhook)
FRAPPE_WEBHOOK_SECRET=put_webhook_secret_here

# Identity cache and reconciliation poller
IDENTITY_CACHE_TTL=60
POLL_INTERVAL_SECONDS=900
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
DAILY_PLAN_HOUR=7
TRANSCRIPT_RETENTION_DAYS=90

# Job nhận xét bài dự án (lms_copilot POST /ai/copilot/jobs/review)
# COPILOT_JOB_KEY phải trùng Copilot Settings > Gateway API Key. Để trống = từ chối mọi job.
COPILOT_JOB_KEY=
# Sandbox chạy test: docker | off (off = không chạy test, ghi "không chạy test")
REVIEW_SANDBOX=off
# Image phải có sẵn pytest vì container chạy với --network none
REVIEW_SANDBOX_IMAGE=python:3.12-slim
REVIEW_TEST_COMMAND=python -m pytest -q -rA -p no:cacheprovider
REVIEW_TEST_TIMEOUT=60
# Thư mục tạm chứa repo; khi Gateway chạy trong container, mount cùng đường dẫn cho Docker host
REVIEW_WORK_DIR=
REVIEW_MAX_REPO_MB=20
REVIEW_MAX_FILES=200
REVIEW_PROMPT_CHARS=60000
REVIEW_LLM_TIMEOUT=180

# Báo cáo điểm vướng tuần: thứ Hai lúc WEEKLY_REPORT_HOUR (theo SCHEDULER_TIMEZONE), cho các khóa sau
WEEKLY_REPORT_HOUR=7
COPILOT_WEEKLY_COURSES=
